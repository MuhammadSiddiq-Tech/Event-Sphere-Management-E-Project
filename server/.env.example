NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb://localhost:27017/eventsphere?replicaSet=rs0
JWT_ACCESS_SECRET=change-me-at-least-32-chars-long
JWT_REFRESH_SECRET=change-me-too-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
BCRYPT_ROUNDS=12
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@eventsphere.test
CLOUDINARY_URL=
UPLOAD_DIR=./uploads
LOG_LEVEL=info
